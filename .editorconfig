root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Fixtures are specimens. They are supposed to look how they look, and
# reformatting them would destroy the thing being tested.
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = unset
indent_size = unset
